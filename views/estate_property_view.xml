
<odoo>

    <!-- SEARCH VIEW -->
    <record id="estate_property_search_view" model="ir.ui.view">
        <field name="name">estate.property.view.search</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"
                    string="Name, Postcode or Description"
                    filter_domain="['|','|' ,('name', 'ilike', self), ('postcode', 'ilike', self),('description', 'ilike', self)]"
                    />

                <filter name="filter_state_new"
                        string="New"
                        domain="[('state', '=', 'new')]"/>
                        
                <filter name="group_by_postcode"
                        string="Postcode"
                        context="{'group_by': 'postcode'}"/>
            </search>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="estate_property_form_view" model="ir.ui.view">
        <field name="name">estate.property.view.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
                 <form>
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="new,accepted,sold,canceled"/>
                        <button name="action_cancel"
                                        type="object"
                                        string="Cancel"
                                        class="btn btn-danger"
                                        invisible="state in ('sold', 'canceled')"
                                        />
                        <button name="action_sold"
                                        type="object"
                                        string="Sold"
                                        class="btn btn-success"
                                        invisible="state != 'accepted'"
                                        />
                    </header> 
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_offers" 
                                    type="object" 
                                    class="oe_stat_button" 
                                    icon="fa-money">
                                <field name="offer_count" string="Offers" widget="statinfo"/>
                            </button>
                        </div>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="property_type_id"/>
                                <!--<field name="state"/>-->
                            </group>

                            <group>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                            </group>
                            <!--<group>
                                <button name="action_cancel"
                                        type="object"
                                        string="Cancel"
                                        class="btn btn-danger"
                                        />
                            </group>-->
                        

                            <group string="Prices">
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                                <field name="best_offer" readonly="1"/>
                            </group>

                            <group string="Areas">
                                <field name="living_area"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="total_area" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Offers">
                                <field name="offer_ids"
                                    context="{
                                                'form_view_ref': 'estate_property_offer_form_view',
                                                'tree_view_ref': 'estate_property_offer_list_view'
                                             }"
                                  />
                            </page>
                            <page string="Tags">
                                <field name="tag_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter>
                    </chatter>
                </form>

        </field>
    </record>

    <!-- LIST VIEW (بدل TREE) -->
    <record id="estate_property_list_view" model="ir.ui.view">
        <field name="name">estate.property.view.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                decoration-danger="state in ('canceled', 'sold')" 
                decoration-success="state == 'accepted'"
                decoration-info="state == 'received'"
            > 
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="postcode"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                <field name="living_area"/>
                <field name="garden_area"/>
                <field name="garden_orientation"/>
                <field name="total_area"/>
                <field name="date_availability" />
                <field name="best_offer" readonly="1"/>
                <field name="state"/>
                <field name="expected_price"/>
                <field name="selling_price"/>
            </list>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Estate Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form,kanban,pivot,graph</field>
        <field name="search_view_id" ref="estate_property_search_view"/>
        <field name="context">{'search_default_filter_state_new': True,}</field>
    </record>

    <record id="action_update_property_status_direct" model="ir.actions.server">
        <field name="name">Update Status (Created Today)</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="state">code</field>
        <field name="code">
today = datetime.date.today()
for rec in records:
    if rec.create_date and rec.create_date.date() == today:
        rec.write({'state': 'received'})
        </field>
    </record>

    <record id="ir_cron_cancel_properties" model="ir.cron">
        <field name="name">Cancel Expired Properties</field>
        <field name="model_id" ref="model_estate_property"/>
        <field name="state">code</field>
        <field name="code">model._cron_cancel_properties()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <!--<field name="nextcall" eval="(datetime.now() + relativedelta(days=1)).strftime('%Y-%m-%d 15:00:00')" />-->
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).strftime('%Y-%m-%d 14:00:00')"/>
        <field name="priority">5</field>

    </record>

    <record id="estate_property_view_kanban" model="ir.ui.view">
        <field name="name">estate.property.kanban</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <kanban default_group_by="property_type_id">
                <field name="state"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    Expected Price: <field name="expected_price"/>
                                </div>
                                <div>
                                    <field name="state"/> 
                                </div>
                                <div>
                                    Postcode: <field name="postcode"/>
                                </div>
                                <div>
                                    <field name="tag_ids" widget="many2many_tags"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>    
            </kanban>
        
        </field>
    </record>

    
    <record id="estate_property_view_pivot" model="ir.ui.view">
        <field name="name">estate.property.pivot</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <pivot string="Property Analysis">
                <field name="selling_price" type="measure"/>
                <field name="property_type_id" type="row"/>
            
            </pivot>
        
        </field>
    </record>


    <record id="estate_property_view_graph" model="ir.ui.view">
        <field name="name">estate.property.graph</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <graph string="Property Analysis" type="bar">
                <field name="tag_ids" type="row"/>

                <field name="expected_price" type="measure"/>
                <field name="selling_price" type="measure"/>
                <field name="best_offer" type="measure"/> </graph>
        </field>
    </record>


    <record id="action_report_estate_property" model="ir.actions.report">
        <field name="name">Property Report</field>
        <field name="model">estate.property</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">estate.report_property_template</field>
        <field name="report_file">estate.report_property_template</field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_property_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="property">
                <t t-call="web.external_layout">
                    <div class="page">
                       <h2 style="text-align: center; margin-top: 50px;">
                        SAFE - TEST REPORT STATIC
                    </h2>
                    <p style="text-align: center;">
                        This is a test report for the estate property with ID
                    </p>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <record id="action_server_generate_property_pdf" model="ir.actions.server">
        <field name="name">Generate Property </field>
        <field name="model_id" ref="model_estate_property"></field>
        <field name="binding_model_id" ref="model_estate_property"/>
        <field name="state">code</field>
        <field name="code">
action = record.env.ref('estate.action_report_estate_property').report_action(records)
        </field>
    </record>

  

<record id="action_send_sold_email" model="ir.actions.server">
    <field name="name">Send Email to Buyer</field>
    <field name="model_id" ref="estate.model_estate_property"/>
    <field name="binding_model_id" ref="estate.model_estate_property"/>
    <field name="binding_view_types">form,list</field>
    <field name="state">code</field>
    <field name="code">
        action = {
            'type': 'ir.actions.act_window',
            'res_model': 'mail.compose.message',
            'view_mode': 'form',
            'target': 'new',
            'context': {
                'default_template_id': env.ref('estate.email_template_property_sold').id,
                'default_model': 'estate.property',
                'default_res_ids': record.ids,
            }
        }
    </field>
</record>

</odoo>
