<odoo>
    <data noupdate="1">
        <record id="estate_property_user_rule" model="ir.rule">
            <field name="name">Personal Properties Only</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="groups" eval="[(4, ref('estate_group_user'))]"/>
        </record>

        <record id="estate_property_manager_rule" model="ir.rule">
            <field name="name">Manager Sees All</field>
            <field name="model_id" ref="model_estate_property"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('estate_manager'))]"/>
        </record>
    </data>
</odoo>