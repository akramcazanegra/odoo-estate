<odoo>
    <record id="module_category_real_estate" model="ir.module.category">
        <field name="name">Real Estate Management</field>
        <field name="sequence">10</field>
    </record>

    <record id="estate_manager" model="res.groups">
        <field name="name">Real Estate Management / Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="estate_group_user" model="res.groups">
        <field name="name">Real Estate Management / User</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="estate_group_default" model="res.groups">
        <field name="name">Real Estate Management / Default</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>