<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_property_sold" model="mail.template">
            <field name="name">Property: Sold Notification</field>
            <field name="model_id" ref="estate.model_estate_property"/>
            <field name="subject">Congratulations! {{ object.name }} is sold</field>
            <field name="email_from">{{ object.create_uid.email_formatted }}</field>
            <field name="body_html" type="html">
                <div>
                    <p>Dear Customer,<br/><br/>
                    Your property <strong><t t-out="object.name"/></strong> has been successfully sold for 
                    <strong><t t-out="object.selling_price"/></strong>.
                    <br/><br/>
                    Thank you!</p>
                </div>
            </field>
        </record>
    </data>
</odoo>